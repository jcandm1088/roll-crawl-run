{
  "name": "roll-crawl-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Roll, Crawl, RUN: Tracking Growth Together — a local-first parenting and development tracking PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "idb": "^8.0.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.7",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "lucide-static": "^1.80.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
